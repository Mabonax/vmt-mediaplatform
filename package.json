{
  "name": "drhealth-motion",
  "version": "1.0.0",
  "description": "Dr. Health programmable motion and design engine",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/canvas": "4.0.532",
    "@remotion/cli": "4.0.533",
    "@remotion/player": "4.0.533",
    "@remotion/tailwind-v4": "4.0.533",
    "@remotion/zod-types": "4.0.533",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.533",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.533",
    "@remotion/renderer": "4.0.533",
    "@rspack/core": "1.7.11",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "node scripts/start-studio.mjs",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src",
    "studio": "node scripts/start-studio.mjs",
    "studio:raw": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "render:vertical": "remotion render src/index.ts DrHealthServicePromo15-Vertical out/dr-health-vertical.mp4",
    "render:square": "remotion render src/index.ts DrHealthServicePromo15-Square out/dr-health-square.mp4",
    "render:landscape": "remotion render src/index.ts DrHealthServicePromo15-Landscape out/dr-health-landscape.mp4",
    "verify:visual": "npm run build && node scripts/verify-visual.mjs",
    "sync:defaults": "node scripts/sync-defaults.mjs && prettier --write src/Root.tsx",
    "gallery:build": "node scripts/build-gallery.mjs",
    "gallery": "npm run gallery:build && node scripts/serve-gallery.mjs",
    "sync:grammar": "node scripts/sync-grammar-examples.mjs",
    "verify:grammar": "npm run build && node scripts/verify-grammar.mjs",
    "editor:build": "node scripts/build-editor.mjs",
    "editor": "npm run editor:build && node scripts/serve-editor.mjs",
    "render:workstation-batch": "node scripts/render-workstation-batch.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
